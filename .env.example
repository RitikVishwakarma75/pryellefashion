# PRAYELE • Haute Hairwear — Environment Variables
# Copy this file to .env.local and populate the secrets

# Database (PostgreSQL via Neon, Supabase, or self-hosted)
DATABASE_URL="postgresql://postgres:password@localhost:5432/prayele?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/prayele?schema=public"

# NextAuth / Auth Configuration
NEXTAUTH_SECRET="prayele-secret-key-change-in-production-min32chars"
NEXTAUTH_URL="http://localhost:3000"

# Object Storage Provider: "cloudinary" | "local" | "s3"
STORAGE_PROVIDER="cloudinary"

# Cloudinary (Product & Gallery Image Upload)
CLOUDINARY_CLOUD_NAME="prayele-boutique"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Razorpay (India Payment Gateway - UPI, Cards, Net Banking)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Resend (Transactional Order Emails)
RESEND_API_KEY="re_your_resend_api_key"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Analytics 4
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
